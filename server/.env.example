# ==============================================================================
# CareerAI — Server Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# Never commit real secrets to version control.
# ==============================================================================

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Authentication & Session Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=yourdomain.com

# Database (MongoDB Atlas)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/careerai?retryWrites=true&w=majority

# AI Engine (Google Gemini)
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
PARSER_TIMEOUT_MS=10000

# Rate Limiting & Abuse Prevention
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_ACCOUNT_MAX=5
# REDIS_URL=redis://default:<password>@<host>:<port>
